<div class="mx-auto max-w-md">
  <h1 class="mb-6 text-3xl font-bold text-slate-900"><%= t(".title") %></h1>

  <div class="rounded-2xl border border-slate-200 bg-white p-6">
    <%= form_with url: session_url do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :email_address, class: "block text-sm font-medium text-slate-700" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-slate-700" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-between gap-4">
        <%= form.submit t(".submit"), class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-medium text-white hover:bg-indigo-500" %>
        <div class="text-sm text-slate-500">
          <%= link_to t("passwords.new.forgot"), new_password_path, class: "text-slate-700 underline hover:no-underline" %>
          <span class="mx-1">·</span>
          <%= t(".sign_up_hint") %> <%= link_to t("layouts.nav.sign_up"), new_registration_path, class: "text-indigo-600 underline hover:no-underline" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
