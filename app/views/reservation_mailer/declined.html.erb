<h1><%= t(".heading") %></h1>

<% if @reservation.slot? %>
  <p><%= t(".body", zone: @reservation.zone, starts: l(@reservation.starts_at, format: :short)) %></p>
<% else %>
  <p><%= t(".body_no_slot", zone: @reservation.zone, date: @reservation.requested_date.strftime("%d.%m.%Y")) %></p>
<% end %>

<% if @reservation.review_note.present? %>
  <p><%= t(".reason", note: @reservation.review_note) %></p>
<% end %>

<p><%= link_to t("reservation_mailer.declined.pick_another"), zones_url %></p>

<p style="color: #888; font-size: 12px;"><%= t("reservation_mailer.footer") %></p>
