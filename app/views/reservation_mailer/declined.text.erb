<%= t(".heading") %>

<% if @reservation.slot? %>
<%= t(".body", zone: @reservation.zone, starts: l(@reservation.starts_at, format: :short)) %>
<% else %>
<%= t(".body_no_slot", zone: @reservation.zone, date: @reservation.requested_date.strftime("%d.%m.%Y")) %>
<% end %>
<%= t(".reason", note: @reservation.review_note) if @reservation.review_note.present? %>

<%= zones_url %>

<%= t("reservation_mailer.footer") %>
