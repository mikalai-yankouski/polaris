<div class="mx-auto max-w-md pt-8">
  <div class="mb-8 text-center">
    <span class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl border border-star-400/30 bg-star-500/10 text-star-400 shadow-[0_0_40px_-8px_rgba(228,188,99,0.55)]">
      <%= icon :sparkle, css_class: "h-6 w-6" %>
    </span>
    <h1 class="heading-display text-2xl font-semibold text-white"><%= t(".title") %></h1>
  </div>

  <% if (alert = flash[:alert]) %>
    <p class="flash flash--alert mb-5" id="alert"><%= alert %></p>
  <% end %>

  <div class="glass hero-rise p-6 sm:p-8" style="--reveal-delay: .1s">
    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :password, class: "label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
        </div>
        <div>
          <%= form.label :password_confirmation, class: "label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
        </div>
      </div>

      <%= form.submit t(".submit"), class: "btn btn--aurora mt-6 w-full" %>
    <% end %>
  </div>
</div>
