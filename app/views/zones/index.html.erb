<div class="mb-8">
  <h1 class="text-3xl font-bold text-slate-900"><%= t(".title") %></h1>
  <p class="mt-2 text-slate-500"><%= t(".subtitle") %></p>
</div>

<% if @zones.any? %>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @zones.each do |zone| %>
      <%= link_to zone_path(zone), class: "block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
        <div class="flex items-start justify-between gap-4">
          <h2 class="text-lg font-semibold text-slate-900"><%= zone %></h2>
          <span class="whitespace-nowrap rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
            <%= t("zones.show.price", amount: money(zone.hourly_rate_cents)) %>
          </span>
        </div>

        <p class="mt-3 line-clamp-2 text-sm text-slate-500"><%= zone.description %></p>

        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600"><%= t(".capacity", count: zone.capacity) %></span>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600"><%= t(".floor", count: zone.floor) %></span>
          <% zone.amenities.each do |amenity| %>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600"><%= amenity %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-400"><%= t(".empty") %></p>
<% end %>
