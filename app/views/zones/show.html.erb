<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold text-slate-900"><%= @zone %></h1>
    <p class="mt-2 max-w-2xl text-slate-500"><%= @zone.description %></p>
  </div>
  <span class="whitespace-nowrap rounded-full bg-indigo-50 px-4 py-2 font-semibold text-indigo-700">
    <%= t(".price", amount: money(@zone.hourly_rate_cents)) %>
  </span>
</div>

<div class="grid gap-8 lg:grid-cols-2">
  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-semibold text-slate-900"><%= t(".book") %></h2>

    <ul class="mt-3 space-y-1 text-sm text-slate-500">
      <li><%= t("zones.index.capacity", count: @zone.capacity) %></li>
      <li><%= t(".min_duration", duration: duration_text(@zone.min_duration_minutes)) %></li>
      <li><%= t(".max_duration", duration: duration_text(@zone.max_duration_minutes)) %></li>
    </ul>

    <% if @zone.amenities.any? %>
      <div class="mt-4">
        <h3 class="text-sm font-semibold text-slate-700"><%= t(".amenities") %></h3>
        <div class="mt-2 flex flex-wrap gap-2 text-xs">
          <% @zone.amenities.each do |amenity| %>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600"><%= amenity %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="mt-4 rounded-xl bg-slate-50 px-4 py-3 text-sm <%= @zone.requires_approval ? "text-amber-700" : "text-emerald-700" %>">
      <%= @zone.requires_approval ? t(".approval_required") : t(".auto_confirm") %>
    </p>

    <% if authenticated? %>
      <%= render "reservations/form", zone: @zone, reservation: @reservation %>
    <% else %>
      <p class="mt-6">
        <%= link_to t("layouts.nav.sign_in"), new_session_path, class: "inline-block rounded-lg bg-indigo-600 px-4 py-2.5 font-medium text-white hover:bg-indigo-500" %>
      </p>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-semibold text-slate-900"><%= t(".upcoming") %></h2>
    <% if @reservations.any? %>
      <ul class="mt-4 divide-y divide-slate-100 text-sm">
        <% @reservations.each do |reservation| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <span class="font-medium text-slate-700">
              <%= l(reservation.starts_at, format: :short) %> — <%= l(reservation.ends_at, format: :time_only) %>
            </span>
            <%= status_badge(reservation) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= t(".no_upcoming") %></p>
    <% end %>
  </section>
</div>
