<% if night_design? %>
<% photo = @zone.cover_photo %>

<%# ---------- Кинематографичный баннер зоны ---------- %>
<section class="relative mx-auto max-w-6xl px-4">
  <div class="zone-card beam reveal min-h-[19rem] sm:min-h-[23rem]">
    <div class="art <%= photo ? "" : "art--#{@zone.room_type}" %>">
      <% if photo %>
        <%= image_tag photo, alt: "" %>
      <% else %>
        <span class="art-glow"></span>
        <%= icon @zone.room_type.to_sym, css_class: "art-icon" %>
      <% end %>
    </div>
    <div class="scrim"></div>

    <span class="chip chip--gold absolute right-5 top-5 z-10 !px-4 !py-2 !text-sm">
      <%= t(".price", amount: money(@zone.hourly_rate_cents)) %>
    </span>

    <div class="relative z-10 p-7 sm:p-9">
      <div class="mb-4 flex flex-wrap gap-2">
        <span class="chip"><%= icon @zone.room_type.to_sym %> <%= @zone.room_type_label %></span>
        <span class="chip"><%= icon :users %> <%= t("zones.index.capacity", count: @zone.capacity) %></span>
        <span class="chip"><%= icon :building %> <%= t("zones.index.floor", count: @zone.floor) %></span>
      </div>
      <h1 class="display-2 text-white"><%= @zone.name %></h1>
      <% if @zone.description.present? %>
        <p class="mt-3 max-w-2xl leading-relaxed text-slate-300"><%= @zone.description %></p>
      <% end %>
    </div>
  </div>
</section>

<div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-6 px-4 py-10 lg:grid-cols-[1.05fr_minmax(0,1fr)]">
  <%# ---------- Бронирование: sticky-карта с живым расчётом ---------- %>
  <section class="glass-deep reveal min-w-0 p-6 sm:p-8 lg:sticky lg:top-28">
    <div class="flex items-center justify-between gap-4">
      <h2 class="heading-display text-xl font-semibold text-white"><%= t(".book") %></h2>
      <span class="flex items-center gap-1.5 text-xs font-medium <%= @zone.requires_approval ? "text-star-300" : "text-emerald-300" %>">
        <%= icon (@zone.requires_approval ? :shield : :check_circle), css_class: "h-3.5 w-3.5" %>
        <%= @zone.requires_approval ? t(".approval_required_short") : t(".auto_confirm_short") %>
      </span>
    </div>

    <% if Bepaid::Config.configured? %>
      <p class="mt-4 flex items-start gap-2.5 rounded-xl border border-aurora-300/20 bg-aurora-500/10 px-4 py-3 text-sm text-aurora-300">
        <%= icon :credit_card, css_class: "mt-0.5 h-4 w-4 shrink-0" %>
        <%= t(".prepayment_note") %>
      </p>
    <% end %>
    <%= render "reservations/form", zone: @zone, reservation: @reservation %>
  </section>

  <%# ---------- Правая колонка: правила, удобства, занятость ---------- %>
  <div class="min-w-0 space-y-6">
    <div class="glass spotlight reveal p-6" style="--reveal-delay: .05s">
      <p class="kicker"><%= t(".rules") %></p>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex items-center gap-3 text-slate-300">
          <%= icon :clock, css_class: "h-4 w-4 shrink-0 text-aurora-300" %>
          <%= t(".min_duration", duration: duration_text(@zone.min_duration_minutes)) %>
        </li>
        <li class="flex items-center gap-3 text-slate-300">
          <%= icon :clock, css_class: "h-4 w-4 shrink-0 text-slate-500" %>
          <%= t(".max_duration", duration: duration_text(@zone.max_duration_minutes)) %>
        </li>
        <li class="flex items-center gap-3 text-slate-300">
          <%= icon :calendar, css_class: "h-4 w-4 shrink-0 text-slate-500" %>
          <%= @zone.requires_approval ? t(".approval_required") : t(".auto_confirm") %>
        </li>
      </ul>
    </div>

    <% if @zone.amenities.any? %>
      <div class="glass spotlight reveal p-6" style="--reveal-delay: .1s">
        <p class="kicker"><%= t(".amenities") %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% @zone.amenities.each do |amenity| %>
            <span class="chip"><%= icon :sparkle, css_class: "h-3 w-3" %> <%= amenity %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% else %>
<% photo = @zone.cover_photo %>

<%# ---------- Шапка зала: компактная, форма сразу видна ---------- %>
<section class="mx-auto max-w-6xl px-4 pt-10">
  <div class="reveal flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <p class="tag"><%= @zone.room_type_label %> · <%= t("zones.index.floor", count: @zone.floor) %> · <%= t("zones.index.capacity", count: @zone.capacity) %></p>
      <h1 class="display-2 mt-3"><%= @zone.name %></h1>
      <% if @zone.description.present? %>
        <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft"><%= @zone.description %></p>
      <% end %>
    </div>
    <p class="plate-price !text-base"><%= t(".price", amount: money(@zone.hourly_rate_cents)) %></p>
  </div>
</section>

<div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-8 px-4 py-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
  <%# ---------- Бронирование: светлая карта с живым расчётом, первым на экране ---------- %>
  <section class="reveal min-w-0 border border-ink/25 bg-paper-card p-6 sm:p-8 lg:sticky lg:top-24">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="heading-display text-xl font-semibold text-ink"><%= t(".book") %></h2>
      <span class="flex items-center gap-1.5 font-mono text-[0.66rem] uppercase tracking-[0.12em] <%= @zone.requires_approval ? "text-atlas-gold" : "text-emerald-700" %>">
        <%= icon (@zone.requires_approval ? :shield : :check_circle), css_class: "h-3.5 w-3.5" %>
        <%= @zone.requires_approval ? t(".approval_required_short") : t(".auto_confirm_short") %>
      </span>
    </div>

    <% if Bepaid::Config.configured? %>
      <p class="mt-4 flex items-start gap-2.5 border border-atlas-blue/25 bg-atlas-blue/5 px-4 py-3 text-sm text-atlas-blue">
        <%= icon :credit_card, css_class: "mt-0.5 h-4 w-4 shrink-0" %>
        <%= t(".prepayment_note") %>
      </p>
    <% end %>
    <%= render "reservations/form", zone: @zone, reservation: @reservation %>
  </section>

  <%# ---------- Правая колонка: фото-планшет, правила, удобства ---------- %>
  <div class="min-w-0 space-y-6">
    <figure class="plate reveal overflow-hidden" style="--reveal-delay: .05s">
      <div class="plate-media <%= photo ? "" : "plate--#{@zone.room_type}" %> !aspect-[4/3]">
        <% if photo %>
          <%= image_tag photo, alt: @zone.to_s %>
        <% else %>
          <span class="plate-art"><%= icon @zone.room_type.to_sym %></span>
        <% end %>
      </div>
      <figcaption class="plate-caption !border-b-0">
        <span><%= t(".plate_caption") %></span>
        <span><%= @zone.building_code %></span>
      </figcaption>
    </figure>

    <div class="reveal border border-ink/25 bg-paper-card p-6" style="--reveal-delay: .1s">
      <p class="tag"><%= t(".standard_tag") %></p>
      <ul class="mt-4 space-y-3.5 text-sm">
        <li class="flex items-start gap-3 text-ink">
          <%= icon :clock, css_class: "mt-0.5 h-4 w-4 shrink-0 text-atlas-blue" %>
          <span><%= t(".min_duration", duration: duration_text(@zone.min_duration_minutes)) %> · <%= t(".max_duration", duration: duration_text(@zone.max_duration_minutes)) %></span>
        </li>
        <li class="flex items-start gap-3 text-ink">
          <%= icon :sparkle, css_class: "mt-0.5 h-4 w-4 shrink-0 text-atlas-blue" %>
          <span><%= t(".standard_clean", minutes: @zone.cleaning_buffer_minutes) %></span>
        </li>
        <li class="flex items-start gap-3 text-ink">
          <%= icon :shield, css_class: "mt-0.5 h-4 w-4 shrink-0 text-atlas-blue" %>
          <span><%= t(".standard_quiet") %></span>
        </li>
        <li class="flex items-start gap-3 text-ink">
          <%= icon :calendar, css_class: "mt-0.5 h-4 w-4 shrink-0 text-ink-soft" %>
          <span><%= @zone.requires_approval ? t(".approval_required") : t(".auto_confirm") %></span>
        </li>
      </ul>
    </div>

    <% if @zone.amenities.any? %>
      <div class="reveal border border-ink/25 bg-paper-card p-6" style="--reveal-delay: .15s">
        <p class="tag"><%= t(".amenities") %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% @zone.amenities.each do |amenity| %>
            <span class="border border-ink/30 bg-paper px-3 py-1 font-mono text-[0.7rem] uppercase tracking-[0.08em] text-ink-soft"><%= amenity %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>
