<% if night_design? %>
<%# ---------- Hero: созвездия ---------- %>
<section class="relative flex min-h-[92vh] flex-col items-center justify-center overflow-hidden px-4 pb-20 pt-4 text-center">
  <canvas id="constellation" class="pointer-events-none absolute inset-0 h-full w-full opacity-70" aria-hidden="true"></canvas>

  <p class="eyebrow hero-rise" style="--reveal-delay: .05s">
    <%= icon :sparkle, css_class: "h-3.5 w-3.5 text-star-400" %>
    <%= t("tagline") %>
  </p>

  <h1 class="display-1 mt-8 max-w-5xl text-white" data-kinetic>
    <%= t(".hero_title") %>
    <span class="text-gradient-aurora block"><%= t(".hero_title_accent") %></span>
  </h1>

  <p class="hero-rise mt-7 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg" style="--reveal-delay: .25s">
    <%= t(".hero_subtitle") %>
  </p>

  <div class="hero-rise mt-10 flex flex-wrap items-center justify-center gap-4" style="--reveal-delay: .35s">
    <%= link_to zones_path, class: "btn btn--aurora pulse-glow !px-7 !py-3.5 text-base" do %>
      <%= t(".hero_cta") %>
      <%= icon :arrow_right, css_class: "h-4.5 w-4.5" %>
    <% end %>
    <% if current_user&.staff? %>
      <%= link_to t("layouts.nav.admin"), admin_root_path, class: "btn btn--ghost !px-6 !py-3.5" %>
    <% end %>
  </div>

  <p class="hero-rise mt-8 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-slate-500" style="--reveal-delay: .5s" aria-hidden="true">
    ✦ <%= t(".marginalia") %> · <%= l(Date.current, format: "%d.%m.%Y") %>
  </p>

  <%# Стеклянная полоса статистики ---------- %>
  <div class="hero-rise absolute inset-x-0 bottom-0 flex justify-center px-4 pb-7" style="--reveal-delay: .55s">
    <div class="glass flex flex-wrap items-center justify-center divide-x divide-white/10 rounded-2xl py-3">
      <div class="flex items-center gap-2.5 px-5 sm:px-7">
        <span class="heading-display text-lg font-semibold text-white"><%= @zones.size %></span>
        <span class="text-xs text-slate-400"><%= t(".stat_spaces") %></span>
      </div>
      <div class="flex items-center gap-2.5 px-5 sm:px-7">
        <span class="heading-display text-lg font-semibold text-white"><%= @zones.map(&:room_type).uniq.size %></span>
        <span class="text-xs text-slate-400"><%= t(".stat_formats") %></span>
      </div>
      <div class="flex items-center gap-2.5 px-5 sm:px-7">
        <%= icon :zap, css_class: "h-4 w-4 text-glow-300" %>
        <span class="text-xs text-slate-400"><%= t(".stat_online") %></span>
      </div>
    </div>
  </div>
</section>

<%# ---------- Marquee форматов (ночь) ---------- %>
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <% 2.times do %>
      <% %w[Кинокомнаты Караоке Бильярд PlayStation Лаундж].each do |item| %>
        <span class="marquee-item"><%= item %> <span class="mq-star">✦</span></span>
      <% end %>
    <% end %>
  </div>
</div>

<%# ---------- Тизер пространств: созвездие залов ---------- %>
<section class="relative mx-auto max-w-6xl overflow-x-clip px-4 py-20" data-constellation-holder>
  <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-72 w-[42rem] max-w-[110vw] -translate-x-1/2 dots-bg" aria-hidden="true"></div>

  <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="kicker"><%= t("zones.index.kicker") %></p>
      <h2 class="display-2 mt-3 text-white"><%= t("zones.index.title") %></h2>
      <p class="mt-2 text-slate-400"><%= t("zones.index.subtitle") %></p>
    </div>
    <span class="chip chip--gold"><%= icon :sparkle %> <%= t("zones.index.count", count: @zones.length) %></span>
  </div>

  <div class="grid auto-rows-[minmax(15rem,auto)] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-constellation>
    <% @zones.first(3).each_with_index do |zone, i| %>
      <%= link_to zone_path(zone), class: "zone-card beam spotlight reveal", style: "--reveal-delay: #{i * 0.08}s", data: { cn: true } do %>
        <% photo = zone.cover_photo %>
        <div class="art <%= photo ? "" : "art--#{zone.room_type}" %>">
          <% if photo %>
            <%= image_tag photo, alt: "" %>
          <% else %>
            <span class="art-glow"></span>
            <%= icon zone.room_type.to_sym, css_class: "art-icon" %>
          <% end %>
        </div>
        <div class="scrim"></div>

        <span class="chip chip--gold absolute right-4 top-4 z-10">
          <%= t("zones.show.price", amount: money(zone.hourly_rate_cents)) %>
        </span>

        <div class="relative z-10 p-6 pt-14">
          <div class="mb-3 flex flex-wrap gap-2">
            <span class="chip"><%= icon zone.room_type.to_sym %> <%= zone.room_type_label %></span>
            <span class="chip"><%= icon :users %> <%= t("zones.index.capacity", count: zone.capacity) %></span>
          </div>
          <h3 class="heading-display text-xl font-semibold text-white"><%= zone.name %></h3>
          <% if zone.description.present? %>
            <p class="mt-2 line-clamp-2 max-w-md text-sm leading-relaxed text-slate-300/90"><%= zone.description %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="reveal mt-10 flex justify-center">
    <%= link_to zones_path, class: "btn btn--ghost !px-7 !py-3.5" do %>
      <%= t(".all_zones", count: @zones.size) %>
      <%= icon :arrow_right, css_class: "h-4.5 w-4.5" %>
    <% end %>
  </div>
</section>

<%# ---------- Преимущества ---------- %>
<section class="relative mx-auto max-w-6xl px-4 py-16">
  <div class="hairline mb-16"></div>

  <% steps = [[t(".feature_1_title"), t(".feature_1_text")],
              [t(".feature_2_title"), t(".feature_2_text")],
              [t(".feature_3_title"), t(".feature_3_text")]] %>
  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    <% steps.each_with_index do |(title, text), i| %>
      <div class="glass spotlight reveal relative overflow-hidden p-7" style="--reveal-delay: #{i * 0.1}s">
        <span class="heading-display absolute -right-2 -top-4 text-7xl font-bold text-white/[0.04]"><%= format("%02d", i + 1) %></span>
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-star-400/25 bg-star-500/10 text-star-400">
          <%= icon [:zap, :credit_card, :shield][i], css_class: "h-5 w-5" %>
        </span>
        <h3 class="mt-5 text-lg font-semibold text-white"><%= title %></h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400"><%= text %></p>
      </div>
    <% end %>
  </div>
</section>

<%# ---------- Внутреннее устройство: факты вместо обещаний (ночь) ---------- %>
<section class="relative mx-auto max-w-6xl px-4 py-16">
  <div class="hairline mb-14"></div>
  <p class="tag reveal"><%= t(".inside_tag") %></p>
  <h2 class="display-2 reveal mt-3 max-w-2xl text-white"><%= t(".inside_title") %></h2>

  <div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
    <% facts = [
          [t(".fact_clean_title"), t(".fact_clean_text")],
          [t(".fact_quiet_title"), t(".fact_quiet_text")],
          [t(".fact_price_title"), t(".fact_price_text")],
          [t(".fact_human_title"), t(".fact_human_text")]] %>
    <% facts.each_with_index do |(title, text), i| %>
      <div class="reveal" style="--reveal-delay: <%= (i % 2) * 0.08 %>s">
        <div class="flex items-start gap-4 border-t border-white/10 pt-5">
          <span class="mt-1.5 text-xs text-aurora-300" aria-hidden="true">&#10022;</span>
          <div>
            <h3 class="font-display text-lg font-semibold text-white"><%= title %></h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-400"><%= text %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<% else %>
<%# ---------- Hero: атлас с залами на первом экране ---------- %>
<section class="relative overflow-hidden">
  <%# Планисфера справа, уходит за край %>
  <div class="parallax-wheel pointer-events-none absolute -right-40 -top-40 hidden opacity-70 lg:block xl:-right-24" aria-hidden="true">
    <%= render "shared/wheel", size: "h-[42rem] w-[42rem]" %>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-16 sm:pt-20">
    <p class="tag hero-rise" style="--reveal-delay: .05s">Залы клуба Polaris</p>

    <h1 class="display-1 mt-6 max-w-3xl" data-kinetic>
      Ваш вечер <%= content_tag :span, "по звёздам", class: "serif-italic text-atlas-blue" %>
    </h1>

    <p class="hero-rise mt-6 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg" style="--reveal-delay: .25s">
      <%= t(".hero_subtitle") %>
    </p>

    <div class="hero-rise mt-9 flex flex-wrap items-center gap-4" style="--reveal-delay: .35s">
      <%= link_to zones_path, class: "btn-ink !px-7 !py-3.5" do %>
        <%= t(".hero_cta") %>
      <% end %>
      <%= link_to "#halls", class: "btn-line !px-7 !py-3.5", data: { turbo: false } do %>
        <%= t(".hero_secondary") %>
      <% end %>
    </div>

    <p class="hero-rise mt-8 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ink-soft/80" style="--reveal-delay: .5s" aria-hidden="true">
      ✦ <%= t(".marginalia") %>
    </p>
  </div>

  <%# Залы сразу: первый экран — товар, а не логотип %>
  <div id="halls" class="relative mx-auto max-w-6xl scroll-mt-24 px-4 pb-16 pt-6" data-constellation-holder>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-constellation>
      <% @zones.first(3).each_with_index do |zone, i| %>
        <%= link_to zone_path(zone), class: "plate hero-rise group", style: "--reveal-delay: #{0.4 + i * 0.12}s", data: { cn: true } do %>
          <div class="plate-media <%= zone.photos.attached? ? "" : "plate--#{zone.room_type}" %>">
            <% if zone.photos.attached? %>
              <%= image_tag zone.cover_photo, alt: zone.to_s %>
            <% else %>
              <span class="plate-art"><%= icon zone.room_type.to_sym %></span>
            <% end %>
            <span class="plate-flag"><%= t("zones.show.price", amount: money(zone.hourly_rate_cents)) %></span>
          </div>
          <div class="plate-caption">
            <span><%= t(".plate_no", no: format("%02d", i + 1)) %> · <%= zone.building_code || "#{zone.floor}эт" %></span>
            <span><%= zone.room_type_label %></span>
          </div>
          <div class="plate-body">
            <h2 class="plate-title"><%= zone.name %></h2>
            <% if zone.description.present? %>
              <p class="line-clamp-2 text-sm leading-relaxed text-ink-soft"><%= zone.description %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="hero-rise mt-8 flex items-center justify-between gap-4" style="--reveal-delay: .8s">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft">
        <%= t(".halls_count", count: @zones.size) %>
      </p>
      <%= link_to zones_path, class: "link-ink" do %>
        <%= t(".all_zones") %> →
      <% end %>
    </div>
  </div>
</section>

<%# ---------- Marquee форматов ---------- %>
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <% 2.times do %>
      <% %w[Кинокомнаты Караоке Бильярд PlayStation Лаундж].each do |item| %>
        <span class="marquee-item"><%= item %> <span class="mq-star">✦</span></span>
      <% end %>
    <% end %>
  </div>
</div>

<%# ---------- Как это работает: строка-легенда атласа ---------- %>
<section class="border-y border-ink/15 bg-paper-card/60">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-3 md:gap-10">
    <% steps = [[t(".step_1_title"), t(".step_1_text")],
                [t(".step_2_title"), t(".step_2_text")],
                [t(".step_3_title"), t(".step_3_text")]] %>
    <% steps.each_with_index do |(title, text), i| %>
      <div class="reveal" style="--reveal-delay: <%= i * 0.1 %>s">
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-sm text-atlas-blue"><%= format("%02d", i + 1) %></span>
          <h3 class="font-display text-xl font-semibold text-ink"><%= title %></h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft"><%= text %></p>
      </div>
    <% end %>
  </div>
</section>


<%# ---------- Внутреннее устройство: факты вместо обещаний ---------- %>
<section class="border-y border-ink/15 bg-paper-card/60">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <p class="tag reveal"><%= t(".inside_tag") %></p>
    <h2 class="display-2 reveal mt-3 max-w-2xl"><%= t(".inside_title") %></h2>

    <div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
      <% facts = [
            [t(".fact_clean_title"), t(".fact_clean_text")],
            [t(".fact_quiet_title"), t(".fact_quiet_text")],
            [t(".fact_price_title"), t(".fact_price_text")],
            [t(".fact_human_title"), t(".fact_human_text")]] %>
      <% facts.each_with_index do |(title, text), i| %>
        <div class="reveal" style="--reveal-delay: <%= (i % 2) * 0.08 %>s">
          <div class="flex items-start gap-4 border-t border-ink/15 pt-5">
            <span class="mt-1.5 text-xs text-atlas-blue" aria-hidden="true">&#10022;</span>
            <div>
              <h3 class="font-display text-lg font-semibold text-ink"><%= title %></h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft"><%= text %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---------- Финал: призыв ---------- %>
<section class="relative mx-auto max-w-6xl overflow-x-clip px-4 py-20 text-center">
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 -translate-x-1/2 -translate-y-1/2 opacity-40" aria-hidden="true">
    <%= render "shared/wheel", size: "h-[36rem] w-[36rem]" %>
  </div>
  <div class="rule-star reveal mx-auto mb-12 max-w-2xl" aria-hidden="true"><span class="rs-star">✦</span></div>
  <p class="tag reveal justify-center"><%= t(".final_tag") %></p>
  <h2 class="display-2 reveal mx-auto mt-5 max-w-2xl">
    <%= t(".final_title") %> <span class="serif-italic text-atlas-blue"><%= t(".final_accent") %></span>
  </h2>
  <div class="reveal mt-9">
    <%= link_to zones_path, class: "btn-ink !px-8 !py-4" do %>
      <%= t(".final_cta") %>
    <% end %>
  </div>
</section>
<% end %>
