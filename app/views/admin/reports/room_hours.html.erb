<div class="admin-page-head">
  <div>
    <h1 class="admin-title"><%= t(".title") %></h1>
    <p class="admin-meta"><%= @from %> — <%= @to %></p>
  </div>
  <%= link_to admin_room_hours_report_path(format: :xlsx, from: @from, to: @to), class: "btn btn--gold !py-2.5 !text-sm" do %>
    <%= t(".export") %> ↓
  <% end %>
</div>

<form action="<%= admin_room_hours_report_path %>" method="get" class="glass mb-6 flex flex-wrap items-end gap-4 p-4">
  <div>
    <label class="label"><%= t(".from") %></label>
    <input type="date" name="from" value="<%= @from %>" class="field !w-auto !py-2 !text-sm">
  </div>
  <div>
    <label class="label"><%= t(".to") %></label>
    <input type="date" name="to" value="<%= @to %>" class="field !w-auto !py-2 !text-sm">
  </div>
  <button class="btn btn--aurora !py-2.5 !text-sm"><%= t(".apply") %></button>
</form>

<div class="glass overflow-x-auto p-0">
  <table class="table-dark">
    <thead>
      <tr>
        <th><%= Zone.model_name.human %></th>
        <th><%= t("admin.reports.room_type") %></th>
        <th><%= t("admin.reports.bookings") %></th>
        <th><%= t("admin.reports.hours") %></th>
        <th><%= t("admin.reports.revenue") %></th>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr>
          <td class="font-medium text-white"><%= row.zone %></td>
          <td class="text-slate-400"><%= row.zone.room_type_label %></td>
          <td class="num"><%= row.bookings %></td>
          <td class="num"><%= number_with_precision(row.hours, precision: 1) %></td>
          <td class="num font-semibold text-star-300"><%= money(row.revenue_cents) %></td>
        </tr>
      <% end %>
      <tr class="border-t-2 border-white/10 bg-white/[0.03] font-semibold">
        <td class="text-white"><%= t("admin.reports.total") %></td>
        <td></td>
        <td class="num text-white"><%= @totals.bookings %></td>
        <td class="num text-white"><%= number_with_precision(@totals.hours, precision: 1) %></td>
        <td class="num text-star-300"><%= money(@totals.revenue_cents) %></td>
      </tr>
    </tbody>
  </table>
</div>
