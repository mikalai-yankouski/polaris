<div class="mx-auto max-w-md pt-8">
  <div class="mb-8 text-center">
    <span class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl border border-star-400/30 bg-star-500/10 text-star-400 shadow-[0_0_40px_-8px_rgba(242,213,138,0.55)]">
      <%= icon :shield, css_class: "h-6 w-6" %>
    </span>
    <h1 class="heading-display text-2xl font-semibold text-white"><%= t(".title") %></h1>
    <p class="mt-2 text-sm text-slate-500"><%= t(".subtitle") %></p>
  </div>

  <div class="glass hero-rise p-6 sm:p-8" style="--reveal-delay: .1s">
    <%= form_with url: admin_session_url do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :email_address, t("activerecord.attributes.user.email_address"), class: "label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
        </div>

        <div>
          <%= form.label :password, t("activerecord.attributes.user.password"), class: "label" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %>
        </div>
      </div>

      <div class="mt-6 flex flex-col gap-4">
        <%= form.submit t(".submit"), class: "btn btn--aurora w-full" %>
        <div class="flex items-center justify-center gap-3 text-sm text-slate-400">
          <%= link_to t("passwords.new.forgot"), new_password_path, class: "link-aurora" %>
          <span class="text-slate-600">·</span>
          <%= link_to t("layouts.nav.zones"), root_path, class: "link-aurora" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
