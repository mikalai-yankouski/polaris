<h1 class="mb-6 text-3xl font-bold text-slate-900"><%= t(".title") %></h1>

<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3"><%= User.human_attribute_name(:name) %></th>
        <th class="px-4 py-3"><%= User.human_attribute_name(:email_address) %></th>
        <th class="px-4 py-3"><%= User.human_attribute_name(:phone) %></th>
        <th class="px-4 py-3"><%= t(".reservations_count") %></th>
        <th class="px-4 py-3"><%= User.human_attribute_name(:role) %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3 font-medium text-slate-900"><%= user %></td>
          <td class="px-4 py-3 text-slate-500"><%= user.email_address %></td>
          <td class="px-4 py-3 text-slate-500"><%= user.phone %></td>
          <td class="px-4 py-3"><%= user.reservations_count %></td>
          <td class="px-4 py-3">
            <% if policy(user).update? %>
              <%= form_with model: user, url: admin_user_path(user), class: "flex items-center gap-2" do |form| %>
                <%= form.select :role,
                      options_for_select(User.roles.map { |role, _| [I18n.t(role, scope: "user_roles"), role] }, user.role),
                      {}, { onchange: "this.form.requestSubmit()", class: "rounded-lg border border-slate-300 px-2 py-1.5 text-xs" } %>
              <% end %>
            <% else %>
              <span class="text-slate-500"><%= I18n.t(user.role, scope: "user_roles") %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
