<% dark = admin_dark? %>
<% base = "glass p-5" %>
<% warning = dark ? "glass p-5 !border-star-400/50 !bg-star-500/10" : "glass p-5 !border-amber-500/60 !bg-amber-500/10" %>
<% overdue = dark ? "glass p-5 !border-rose-400/50 !bg-rose-500/10" : "glass p-5 !border-rose-500/60 !bg-rose-500/10" %>

<div class="<%= base %>"
     data-controller="countdown"
     data-countdown-ends-at-value="<%= reservation.ends_at.iso8601 %>"
     data-countdown-warning-seconds-value="600"
     data-base-class="<%= base %>"
     data-warning-class="<%= warning %>"
     data-overdue-class="<%= overdue %>">
  <div class="flex items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate font-semibold <%= dark ? "text-white" : "text-ink" %>">
        <%= reservation.zone %>
        <span class="text-xs font-normal text-slate-500">до <%= l(reservation.ends_at, format: :time_only) %></span>
      </p>
      <p class="truncate text-sm text-slate-400"><%= reservation.client_name %> · <%= reservation.guests_count %> чел.</p>
    </div>
    <p data-countdown-target="label" class="heading-display shrink-0 text-2xl font-semibold tabular-nums <%= dark ? "text-white" : "text-ink" %>">--:--</p>
  </div>
</div>
