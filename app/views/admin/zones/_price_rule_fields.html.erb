<tr class="price-rule-fields border-b border-white/[0.05] last:border-0" data-new-record="<%= f.object.new_record? %>">
  <td class="pr-3 py-1.5">
    <%= f.select :day_kind,
          options_for_select(PriceRule.day_kinds.keys.map { |k| [I18n.t(k, scope: "day_kinds"), k] }, f.object.day_kind),
          {}, { class: "field !w-auto !py-1.5 !text-sm" } %>
  </td>
  <td class="pr-3 py-1.5 whitespace-nowrap">
    <%= f.time_select :starts_at_time, { minute_step: 30, ignore_date: true }, { class: "field !inline-block !w-auto !px-1.5 !py-1.5 !text-sm" } %>
    <span class="text-slate-500">—</span>
    <%= f.time_select :ends_at_time, { minute_step: 30, ignore_date: true }, { class: "field !inline-block !w-auto !px-1.5 !py-1.5 !text-sm" } %>
  </td>
  <td class="pr-3 py-1.5">
    <%= f.number_field :hourly_rate_cents, min: 100, step: 100, class: "field !w-32 !py-1.5 !text-sm" %>
  </td>
  <td class="py-1.5 text-right">
    <%= f.check_box :_destroy, class: "hidden" %>
    <button type="button" data-action="price-rules#remove"
            class="a-btn a-btn--danger" title="<%= t("admin.zones.form.remove_rule") %>">✕</button>
  </td>
</tr>
