<div class="admin-page-head">
  <div>
    <h1 class="admin-title"><%= t(".title") %></h1>
    <p class="admin-meta"><%= t(".count", count: @zones.size) %></p>
  </div>
  <%= link_to new_admin_zone_path, class: "btn btn--aurora !py-2.5 !text-sm" do %>
    <%= icon :sparkle, css_class: "h-4 w-4" %>
    <%= t(".new") %>
  <% end %>
</div>

<% if @zones.any? %>
  <div class="glass overflow-x-auto p-0">
    <table class="table-dark">
      <thead>
        <tr>
          <th><%= Zone.human_attribute_name(:name) %></th>
          <th><%= Zone.human_attribute_name(:capacity) %></th>
          <th><%= Zone.human_attribute_name(:floor) %></th>
          <th><%= Zone.human_attribute_name(:hourly_rate_cents) %></th>
          <th><%= Zone.human_attribute_name(:requires_approval) %></th>
          <th><%= Zone.human_attribute_name(:active) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @zones.each do |zone| %>
          <tr>
            <td class="font-medium text-white">
              <%= link_to zone, zone_path(zone), class: "link-aurora" %>
              <span class="block text-xs text-slate-500"><%= zone.room_type_label %></span>
            </td>
            <td class="num"><%= zone.capacity %></td>
            <td class="num"><%= zone.floor %></td>
            <td class="num font-semibold text-star-300"><%= money(zone.hourly_rate_cents) %></td>
            <td><span class="text-slate-500"><%= zone.requires_approval ? "•" : "—" %></span></td>
            <td>
              <span class="badge <%= zone.active? ? "badge--confirmed" : "badge--cancelled" %>"><%= zone.active? ? t(".active") : t(".inactive") %></span>
            </td>
            <td>
              <div class="flex justify-end gap-1.5">
                <%= link_to t("admin.actions.edit"), edit_admin_zone_path(zone), class: "a-btn a-btn--ghost" %>
                <% if policy(zone).destroy? %>
                  <%= button_to t("admin.actions.destroy"), admin_zone_path(zone), method: :delete,
                        form: { data: { turbo_confirm: "Удалить зону «#{zone}»?" } },
                        class: "a-btn a-btn--danger" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="glass p-12 text-center text-slate-500"><%= t(".empty") %></p>
<% end %>
