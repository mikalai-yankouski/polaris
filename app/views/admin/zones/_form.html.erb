<% if zone.errors.any? %>
  <div class="mb-6 rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-700">
    <ul class="list-inside list-disc">
      <% zone.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: zone, url: zone.new_record? ? admin_zones_path : admin_zone_path(zone), class: "space-y-5" do |form| %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :name, required: true, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :building_code, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :building_code, placeholder: "2-8", class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :room_type, class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :room_type,
            options_for_select(Zone.room_types.map { |t, _| [I18n.t(t, scope: "room_types"), t] }, zone.room_type),
            {}, { class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" } %>
    </div>

    <div>
      <%= form.label :cleaning_buffer_minutes, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :cleaning_buffer_minutes, min: 0, max: 120, step: 5, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
      <p class="mt-1 text-xs text-slate-400"><%= t("admin.zones.form.children_party_hint") %></p>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :building_id, class: "block text-sm font-medium text-slate-700" %>
      <%= form.collection_select :building_id, Building.all, :id, :name, { prompt: true }, { class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" } %>
    </div>

    <div>
      <%= form.label :floor, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :floor, min: 0, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :capacity, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :capacity, min: 1, required: true, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :hourly_rate_cents, "#{Zone.human_attribute_name(:hourly_rate_cents)} (коп.)", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :hourly_rate_cents, min: 0, step: 50, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :min_duration_minutes, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :min_duration_minutes, min: 15, step: 15, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div>
      <%= form.label :max_duration_minutes, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :max_duration_minutes, min: 30, step: 30, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :amenity_ids, Zone.human_attribute_name(:amenities), class: "block text-sm font-medium text-slate-700" %>
      <div class="mt-2 flex flex-wrap gap-3">
        <%= form.collection_check_boxes :amenity_ids, Amenity.all, :id, :name do |b| %>
          <label class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <%= b.check_box class: "rounded" %> <%= b.text %>
          </label>
        <% end %>
      </div>
    </div>

    <label class="flex items-center gap-3 text-sm font-medium text-slate-700">
      <%= form.check_box :requires_approval, class: "rounded" %> <%= Zone.human_attribute_name(:requires_approval) %>
    </label>

    <label class="flex items-center gap-3 text-sm font-medium text-slate-700">
      <%= form.check_box :active, class: "rounded" %> <%= Zone.human_attribute_name(:active) %>
    </label>

    <div class="sm:col-span-2">
      <%= form.label :adjacent_zone_ids, Zone.human_attribute_name(:adjacent_zones), class: "block text-sm font-medium text-slate-700" %>
      <div class="mt-2 flex flex-wrap gap-3">
        <%= form.collection_check_boxes :adjacent_zone_ids, Zone.where.not(id: zone.id).ordered, :id, :to_s do |b| %>
          <label class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <%= b.check_box class: "rounded" %> <%= b.text %>
          </label>
        <% end %>
      </div>
      <p class="mt-1 text-xs text-slate-400"><%= t("admin.zones.form.adjacency_hint") %></p>
    </div>
  </div>

  <fieldset class="mt-6 rounded-xl border border-slate-200 p-4" data-controller="price-rules">
    <legend class="px-2 text-sm font-semibold text-slate-700"><%= t("admin.zones.form.price_rules") %></legend>
    <p class="mb-3 text-xs text-slate-400"><%= t("admin.zones.form.price_rules_hint") %></p>

    <table class="w-full text-sm">
      <thead class="text-left text-xs uppercase text-slate-400">
        <tr>
          <th class="pb-2 pr-3"><%= PriceRule.human_attribute_name(:day_kind) %></th>
          <th class="pb-2 pr-3"><%= t("admin.zones.form.time_window") %></th>
          <th class="pb-2 pr-3"><%= PriceRule.human_attribute_name(:hourly_rate_cents) %> (коп.)</th>
          <th class="pb-2"></th>
        </tr>
      </thead>
      <tbody data-price-rules-target="rows">
        <%= form.fields_for :price_rules do |rule_form| %>
          <%= render "price_rule_fields", f: rule_form %>
        <% end %>
      </tbody>
    </table>

    <template data-price-rules-target="template">
      <%= form.fields_for :price_rules, PriceRule.new, child_index: "NEW_RECORD" do |rule_form| %>
        <%= render "price_rule_fields", f: rule_form %>
      <% end %>
    </template>

    <button type="button" data-action="price-rules#add"
            class="mt-3 cursor-pointer rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50">
      + <%= t("admin.zones.form.add_rule") %>
    </button>
  </fieldset>

  <%= form.submit t(".submit"), class: "mt-6 cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 font-medium text-white hover:bg-indigo-500" %>
<% end %>
