<div class="admin-page-head">
  <h1 class="admin-title"><%= Amenity.model_name.human %></h1>
</div>

<div class="glass max-w-md p-6">
  <%= form_with model: @amenity, url: admin_amenity_path(@amenity) do |form| %>
    <% if @amenity.errors.any? %>
      <p class="mb-3 text-sm text-rose-300"><%= @amenity.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex gap-3">
      <%= form.text_field :name, required: true, class: "field" %>
      <%= form.submit t(".submit"), class: "btn btn--aurora !py-2.5 !text-sm" %>
    </div>
  <% end %>
</div>
