<h1 class="mb-6 text-3xl font-bold text-slate-900"><%= Amenity.model_name.human %></h1>

<div class="max-w-md rounded-2xl border border-slate-200 bg-white p-6">
  <%= form_with model: @amenity, url: admin_amenity_path(@amenity) do |form| %>
    <% if @amenity.errors.any? %>
      <p class="mb-3 text-sm text-rose-600"><%= @amenity.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex gap-3">
      <%= form.text_field :name, required: true,
            class: "block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-indigo-600" %>
      <%= form.submit t("admin.zones.form.submit"), class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
    </div>
  <% end %>
</div>
