<div class="admin-page-head">
  <h1 class="admin-title"><%= t(".title") %></h1>
</div>

<div class="glass mb-6 max-w-xl p-5">
  <%= form_with model: @amenity, url: admin_amenities_path do |form| %>
    <% if @amenity.errors.any? %>
      <p class="mb-3 text-sm text-rose-300"><%= @amenity.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex gap-3">
      <%= form.text_field :name, required: true, placeholder: t(".new_placeholder"), class: "field" %>
      <%= form.submit t(".add"), class: "btn btn--aurora !py-2.5 !text-sm" %>
    </div>
  <% end %>
</div>

<% if @amenities.any? %>
  <div class="glass max-w-xl p-0">
    <ul class="divide-y divide-white/[0.06] px-5 text-sm">
      <% @amenities.each do |amenity| %>
        <li class="flex items-center justify-between gap-3 py-3.5">
          <span class="font-medium text-white"><%= amenity %>
            <span class="ml-1 text-xs font-normal text-slate-500">· <%= amenity.zones.count %> <%= t(".zones_count") %></span>
          </span>
          <div class="flex items-center gap-1.5">
            <%= link_to t("admin.actions.edit"), edit_admin_amenity_path(amenity), class: "a-btn a-btn--ghost" %>
            <% if policy(amenity).destroy? %>
              <%= button_to "✕", admin_amenity_path(amenity), method: :delete,
                    form: { data: { turbo_confirm: "Удалить «#{amenity}»?" } },
                    class: "a-btn a-btn--danger" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
