<%# Вход по пину: сайт в тестовом режиме. Самостоятельная страница — своё мини-небо, без шапки и футера %>
<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background:
          radial-gradient(42rem 26rem at 68% 18%, rgba(90, 79, 216, 0.22), transparent 70%),
          radial-gradient(38rem 24rem at 18% 82%, rgba(38, 53, 124, 0.28), transparent 70%),
          #05070f;
        color: #e9edf9;
        font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .gate { width: min(23rem, 100%); text-align: center; }

      .gate-star { width: 3rem; height: 3rem; margin: 0 auto 1.1rem; color: #f2d58a; }
      .gate-star svg { width: 100%; height: 100%; display: block; }

      .gate-tag {
        margin: 0;
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #8b93b8;
      }
      .gate-title {
        margin: 0.6rem 0 0;
        font-size: 1.55rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        color: #fff;
      }
      .gate-hint {
        margin: 0.7rem auto 0;
        max-width: 17rem;
        font-size: 0.88rem;
        line-height: 1.55;
        color: #9aa5c7;
      }

      .gate-form { margin: 1.6rem 0 0; }
      .gate-input {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0.9rem;
        padding: 0.85rem 1rem;
        color: #fff;
        font-size: 1.25rem;
        letter-spacing: 0.45em;
        text-align: center;
        text-indent: 0.45em; /* компенсация letter-spacing последней цифры */
        caret-color: #f2d58a;
        transition: border-color 0.2s ease;
      }
      .gate-input::placeholder { color: #4c567c; letter-spacing: 0.2em; text-indent: 0; }
      .gate-input:focus { outline: none; border-color: rgba(242, 213, 138, 0.55); }

      .gate-submit {
        width: 100%;
        margin-top: 0.75rem;
        border: 0;
        border-radius: 0.9rem;
        padding: 0.85rem 1rem;
        background: linear-gradient(135deg, #f2d58a 0%, #e4bc63 100%);
        color: #171204;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: filter 0.2s ease;
      }
      .gate-submit:hover { filter: brightness(1.06); }

      .gate-error { margin: 0.8rem 0 0; font-size: 0.82rem; color: #e08a7a; }
      .gate-locked { margin: 0.9rem auto 0; max-width: 17rem; font-size: 0.85rem; line-height: 1.5; color: #f2d58a; }

      .gate-foot { margin: 1.9rem 0 0; font-size: 0.72rem; letter-spacing: 0.08em; color: #5d6a8c; }
    </style>
  </head>
  <body>
    <main class="gate">
      <div class="gate-star" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.6 6.5 4.9 10.8 12 12-7.1 1.2-11.4 5.5-12 12-.6-6.5-4.9-10.8-12-12C7.1 10.8 11.4 6.5 12 0Z"/></svg>
      </div>

      <p class="gate-tag">Тестовый режим</p>
      <h1 class="gate-title">Polaris ещё не открыт</h1>
      <p class="gate-hint">Мы обкатываем бронирование на своих. Введите пин-код — залы откроются.</p>

      <% if @locked %>
        <p class="gate-locked">Слишком много попыток подряд. Подождите десять минут — форма снова заработает.</p>
      <% else %>
        <%= form_with url: enter_path, method: :post, local: true, data: { turbo: false }, class: "gate-form" do %>
          <input type="hidden" name="return_to" value="<%= session[:return_to] %>">
          <input type="password" name="pin" inputmode="numeric" autocomplete="off" autofocus="autofocus"
                 placeholder="Пин-код" aria-label="Пин-код" maxlength="12" required
                 class="gate-input">
          <% if @failed %>
            <p class="gate-error">Не тот пин. Спросите у нас — и попробуйте ещё раз.</p>
          <% end %>
          <button type="submit" class="gate-submit">Войти на сайт</button>
        <% end %>
      <% end %>

      <p class="gate-foot">Polaris · polarisclub.by</p>
    </main>
  </body>
</html>
