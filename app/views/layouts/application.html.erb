<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <% if admin_section? %>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Unbounded:wght@500;600;700&display=swap" rel="stylesheet">
    <% else %>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">
    <% end %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% if admin_section? %>
    <% admin_klass = night_design? ? "theme-dark" : "admin-light" %>
    <body class="<%= admin_klass %> min-h-screen antialiased">
      <% unless night_design? %><div class="atlas-bg" aria-hidden="true"></div><% end %>
      <div class="sky sky--calm" aria-hidden="true">
        <div class="aurora aurora--violet"></div>
        <div class="aurora aurora--indigo"></div>
      </div>

      <%# Сайдбар (десктоп) %>
      <aside class="admin-sidebar">
        <%= link_to root_path, class: "logo-mark mb-4 px-2.5" do %>
          <span class="logo-gem"><%= icon :sparkle, css_class: "h-4 w-4" %></span>
          <span class="heading-display text-sm font-semibold tracking-wide text-white"><%= t("app_name") %></span>
        <% end %>

        <p class="side-group"><%= t("admin.sidebar.overview") %></p>
        <%= side_link t("admin.nav.dashboard"), admin_root_path, :zap %>
        <%= side_link t("admin.nav.schedule"), admin_schedule_path, :calendar %>

        <p class="side-group"><%= t("admin.sidebar.management") %></p>
        <%= side_link t("admin.nav.reservations"), admin_reservations_path, :clock %>
        <%= side_link t("admin.nav.zones"), admin_zones_path, :building %>
        <%= side_link t("admin.nav.amenities"), admin_amenities_path, :sparkle %>
        <%= side_link t("admin.nav.clients"), admin_clients_path, :users %>

        <p class="side-group"><%= t("admin.sidebar.analytics") %></p>
        <%= side_link t("admin.nav.reports"), admin_room_hours_report_path, :check_circle %>

        <div class="mt-auto space-y-1 border-t border-white/[0.07] pt-4 admin-sidebar-foot">
          <%# Тема едина с публичным сайтом: тот же переключатель %>
          <% if night_design? %>
            <%= button_to theme_switch_path(theme: "atlas"), method: :post,
                  class: "side-link w-full cursor-pointer !justify-start",
                  title: t(".atlas_theme"), aria: { label: t(".atlas_theme") } do %>
              <%= icon :sun, css_class: "h-4 w-4" %><span><%= t(".atlas_theme") %></span>
            <% end %>
          <% else %>
            <%= button_to theme_switch_path(theme: "night"), method: :post,
                  class: "side-link w-full cursor-pointer !justify-start",
                  title: t(".night_theme"), aria: { label: t(".night_theme") } do %>
              <%= icon :moon, css_class: "h-4 w-4" %><span><%= t(".night_theme") %></span>
            <% end %>
          <% end %>
          <%= link_to root_path, class: "side-link" do %>
            <%= icon :arrow_right, css_class: "rotate-180" %><%= t("admin.sidebar.view_site") %>
          <% end %>
          <% if authenticated? %>
            <div class="side-link cursor-default">
              <span class="flex h-6 w-6 items-center justify-center rounded-full border border-star-400/30 bg-star-500/10 text-[0.6rem] font-semibold text-star-400"><%= current_user.name.to_s.first.upcase %></span>
              <span class="truncate text-xs text-slate-400"><%= current_user %></span>
            </div>
            <%= button_to t("layouts.nav.sign_out"), admin_session_path, method: :delete, class: "side-link w-full cursor-pointer !justify-start" %>
          <% end %>
        </div>
      </aside>

      <div class="lg:pl-60">
        <%# Мобильная навигация %>
        <header class="sticky top-0 z-40 border-b border-white/[0.07] bg-night-950/75 backdrop-blur-xl lg:hidden">
          <div class="flex items-center gap-3 px-4 py-3">
            <%= link_to admin_root_path, class: "logo-mark" do %>
              <span class="logo-gem !h-7 !w-7"><%= icon :sparkle, css_class: "h-3.5 w-3.5" %></span>
              <span class="heading-display text-xs font-semibold text-white"><%= t("layouts.nav.admin") %></span>
            <% end %>
            <% if authenticated? %>
              <span class="ml-auto truncate text-xs text-slate-400"><%= current_user %></span>
              <% if night_design? %>
                <%= button_to theme_switch_path(theme: "atlas"), method: :post, class: "theme-toggle !rounded-full",
                      form: { class: "inline" }, title: t(".atlas_theme"), aria: { label: t(".atlas_theme") } do %>
                  <%= icon :sun, css_class: "h-3.5 w-3.5" %>
                <% end %>
              <% else %>
                <%= button_to theme_switch_path(theme: "night"), method: :post, class: "theme-toggle !rounded-full",
                      form: { class: "inline" }, title: t(".night_theme"), aria: { label: t(".night_theme") } do %>
                  <%= icon :moon, css_class: "h-3.5 w-3.5" %>
                <% end %>
              <% end %>
              <%= button_to t("layouts.nav.sign_out"), admin_session_path, method: :delete, class: "cursor-pointer text-xs font-medium text-slate-400 hover:text-white" %>
            <% end %>
          </div>
          <nav class="flex gap-1.5 overflow-x-auto px-4 pb-3 text-sm">
            <% [[t("admin.nav.dashboard"), admin_root_path], [t("admin.nav.schedule"), admin_schedule_path],
                [t("admin.nav.reservations"), admin_reservations_path], [t("admin.nav.zones"), admin_zones_path],
                [t("admin.nav.amenities"), admin_amenities_path], [t("admin.nav.clients"), admin_clients_path],
                [t("admin.nav.reports"), admin_room_hours_report_path]].each do |label, path| %>
              <%= link_to label, path, class: "chip #{'chip--gold' if current_page?(path)}" %>
            <% end %>
          </nav>
        </header>

        <main class="mx-auto max-w-6xl px-4 py-8 lg:px-8">
          <% if (notice = flash[:notice]) %>
            <p class="flash flash--notice mb-6" id="notice"><%= notice %></p>
          <% end %>
          <% if (alert = flash[:alert]) %>
            <p class="flash flash--alert mb-6" id="alert"><%= alert %></p>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </body>
  <% else %>
    <% if night_design? %>
      <%# ============ НОЧНОЕ НЕБО (дизайн v1) ============ %>
      <body class="design-night min-h-screen antialiased">
        <%# Живое небо: звёзды, аврора, зерно %>
        <div class="sky" aria-hidden="true">
          <div class="stars stars--sm"></div>
          <div class="stars stars--md"></div>
          <div class="aurora aurora--violet"></div>
          <div class="aurora aurora--teal"></div>
          <div class="aurora aurora--indigo"></div>
        </div>
        <div class="grain" aria-hidden="true"></div>

        <%# Плавающий нав-остров %>
        <div class="nav-shell">
          <div class="nav-pill">
            <%= link_to root_path, class: "logo-mark" do %>
              <span class="logo-gem"><%= icon :sparkle, css_class: "h-4 w-4" %></span>
              <span class="heading-display text-[0.95rem] font-semibold tracking-wide text-white"><%= t("app_name") %></span>
            <% end %>

            <nav class="flex items-center gap-6">
              <%= nav_link t("layouts.nav.zones"), zones_path %>
              <% if current_user&.staff? %>
                <%= nav_link t("layouts.nav.admin"), admin_root_path %>
              <% end %>
            </nav>

            <div class="flex items-center gap-3">
              <% if authenticated? %>
                <span class="flex items-center gap-2">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-star-400/30 bg-star-500/10 text-xs font-semibold text-star-400"><%= current_user.name.to_s.first.upcase %></span>
                  <span class="hidden text-sm text-slate-400 md:inline"><%= current_user %></span>
                </span>
                <%= button_to t("layouts.nav.sign_out"), admin_session_path, method: :delete, class: "cursor-pointer rounded-full border border-white/15 px-3.5 py-1.5 text-sm font-medium text-slate-300 transition-colors hover:border-white/30 hover:text-white" %>
              <% end %>
              <%= button_to theme_switch_path(theme: "atlas"), method: :post, class: "theme-toggle",
                    form: { class: "inline" }, title: t(".atlas_theme"), aria: { label: t(".atlas_theme") } do %>
                <%= icon :sun, css_class: "h-4 w-4" %>
              <% end %>
            </div>
          </div>
        </div>

        <main class="pt-28">
          <% if (notice = flash[:notice]) %>
            <div class="mx-auto max-w-6xl px-4">
              <p class="flash flash--notice mb-6" id="notice"><%= notice %></p>
            </div>
          <% end %>
          <% if (alert = flash[:alert]) %>
            <div class="mx-auto max-w-6xl px-4">
              <p class="flash flash--alert mb-6" id="alert"><%= alert %></p>
            </div>
          <% end %>

          <%= yield %>
        </main>

        <footer class="relative mt-24">
          <div class="hairline"></div>
          <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-10">
            <div class="logo-mark">
              <span class="logo-gem"><%= icon :sparkle, css_class: "h-3.5 w-3.5" %></span>
              <div>
                <span class="heading-display block text-sm font-medium text-slate-200"><%= t("app_name") %></span>
                <span class="text-xs text-slate-500"><%= t("tagline") %></span>
              </div>
            </div>
            <nav class="flex items-center gap-6 text-sm">
              <%= nav_link t("layouts.nav.zones"), zones_path %>
            </nav>
          </div>
        </footer>
      </body>
    <% else %>
      <%# ============ АТЛАС (светлая) ============ %>
      <body class="theme-paper min-h-screen antialiased">
        <%# Бумага звёздного атласа: лучи, точки-звёзды, зерно %>
        <div class="atlas-bg" aria-hidden="true"></div>
        <div class="grain-paper" aria-hidden="true"></div>

        <%# Верхняя планка %>
        <header class="topbar" data-controller="topbar">
          <div class="mx-auto flex max-w-6xl items-center gap-x-8 gap-y-2 px-4 py-3.5">
            <%= link_to root_path, class: "wordmark" do %>
              Polaris<span class="star">✦</span>
            <% end %>

            <nav class="hidden items-center gap-7 sm:flex">
              <%= nav_link t("layouts.nav.zones"), zones_path %>
              <% if current_user&.staff? %>
                <%= nav_link t("layouts.nav.admin"), admin_root_path %>
              <% end %>
            </nav>

            <div class="ml-auto flex items-center gap-4">
              <%# Публичного входа нет: клиенты бронируют без аккаунта, персонал — по спец-ссылке /admin/session %>
              <% if authenticated? %>
                <span class="flex items-center gap-2">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-ink/30 bg-white text-[0.62rem] font-semibold text-atlas-blue"><%= current_user.name.to_s.first.upcase %></span>
                  <span class="hidden text-xs text-ink-soft md:inline"><%= current_user %></span>
                </span>
                <%= button_to t("layouts.nav.sign_out"), admin_session_path, method: :delete, class: "link-ink !text-[0.66rem] cursor-pointer" %>
              <% end %>
              <%= button_to theme_switch_path(theme: "night"), method: :post, class: "theme-toggle",
                    form: { class: "inline" }, title: t(".night_theme"), aria: { label: t(".night_theme") } do %>
                <%= icon :moon, css_class: "h-4 w-4" %>
              <% end %>
              <%= link_to t(".book_cta"), zones_path, class: "btn-ink hidden !px-4 !py-2 !text-[0.7rem] sm:inline-flex" %>
            </div>
          </div>
          <nav class="flex gap-5 overflow-x-auto border-t border-ink/10 px-4 py-2 sm:hidden">
            <%= nav_link t("layouts.nav.zones"), zones_path %>
            <% if current_user&.staff? %>
              <%= nav_link t("layouts.nav.admin"), admin_root_path %>
            <% end %>
          </nav>
        </header>

        <main>
          <% if (notice = flash[:notice]) %>
            <div class="mx-auto max-w-6xl px-4 pt-6">
              <p class="flash flash--notice mb-6" id="notice"><%= notice %></p>
            </div>
          <% end %>
          <% if (alert = flash[:alert]) %>
            <div class="mx-auto max-w-6xl px-4 pt-6">
              <p class="flash flash--alert mb-6" id="alert"><%= alert %></p>
            </div>
          <% end %>

          <%= yield %>
        </main>

        <footer class="mt-24 border-t border-ink/20">
          <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-10">
            <div>
              <span class="wordmark !text-xl">Polaris<span class="star">✦</span></span>
              <p class="mt-1 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-ink-soft"><%= t("tagline") %></p>
            </div>
            <nav class="flex items-center gap-6">
              <%= nav_link t("layouts.nav.zones"), zones_path %>
            </nav>
          </div>
        </footer>
      </body>
    <% end %>
  <% end %>
</html>
