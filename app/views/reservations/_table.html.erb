<table class="table-dark">
  <thead>
    <tr>
      <th><%= Reservation.human_attribute_name(:zone) %></th>
      <th><%= Reservation.human_attribute_name(:starts_at) %></th>
      <th><%= Reservation.human_attribute_name(:ends_at) %></th>
      <th><%= Reservation.human_attribute_name(:guests_count) %></th>
      <th><%= Reservation.human_attribute_name(:total_price_cents) %></th>
      <th><%= Reservation.human_attribute_name(:status) %></th>
      <th><%= t("payments.title") %></th>
      <% if cancellable %><th><span class="sr-only"><%= t("reservations.index.cancel") %></span></th><% end %>
    </tr>
  </thead>
  <tbody>
    <% reservations.each do |reservation| %>
      <tr>
        <td class="font-medium text-white"><%= link_to reservation.zone, zone_path(reservation.zone), class: "link-aurora" %></td>
        <td class="num"><%= l(reservation.starts_at, format: :short) %></td>
        <td class="num"><%= l(reservation.ends_at, format: :short) %></td>
        <td class="num"><%= reservation.guests_count %></td>
        <td class="num font-semibold text-star-300"><%= money(reservation.total_price_cents) %></td>
        <td>
          <%= status_badge(reservation) %>
          <% if reservation.review_note.present? %>
            <span class="mt-1 block text-xs text-slate-500"><%= reservation.review_note %></span>
          <% end %>
        </td>
        <td>
          <%= payment_badge(reservation) %>
          <% if reservation.payable? && policy(reservation).pay? %>
            <%= button_to t("payments.pay"), reservation_payment_path(reservation), method: :post,
                  class: "mt-1.5 cursor-pointer text-xs font-semibold text-aurora-300 transition-colors hover:text-white" %>
          <% end %>
        </td>
        <% if cancellable %>
          <td class="text-right">
            <% if reservation.cancellable? %>
              <%= button_to t("reservations.index.cancel"), cancel_reservation_path(reservation), method: :post,
                    data: { turbo_confirm: t("reservations.index.cancel_confirm") },
                    class: "link-danger cursor-pointer text-xs" %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
