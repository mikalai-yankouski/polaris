<h1 class="mb-8 text-3xl font-bold text-slate-900"><%= t(".title") %></h1>

<section class="mb-10">
  <h2 class="mb-4 text-lg font-semibold text-slate-900"><%= t(".upcoming") %></h2>
  <% if @upcoming.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <%= render "table", reservations: @upcoming, cancellable: true %>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-400"><%= t(".empty_upcoming") %></p>
  <% end %>
</section>

<section>
  <h2 class="mb-4 text-lg font-semibold text-slate-900"><%= t(".past") %></h2>
  <% if @past.any? %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <%= render "table", reservations: @past, cancellable: false %>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-400"><%= t(".empty_past") %></p>
  <% end %>
</section>
