<div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="kicker"><%= t(".kicker") %></p>
    <h1 class="display-2 mt-3 text-white"><%= t(".title") %></h1>
  </div>
  <%= link_to zones_path, class: "btn btn--ghost !py-2.5 !text-sm" do %>
    <%= t(".browse") %>
    <%= icon :arrow_right, css_class: "h-4 w-4" %>
  <% end %>
</div>

<section class="mb-12">
  <h2 class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-wider text-slate-400">
    <%= icon :calendar, css_class: "h-4 w-4 text-aurora-300" %>
    <%= t(".upcoming") %>
    <% if @upcoming.any? %><span class="chip !py-1"><%= @upcoming.size %></span><% end %>
  </h2>
  <% if @upcoming.any? %>
    <div class="glass overflow-x-auto p-0">
      <%= render "table", reservations: @upcoming, cancellable: true %>
    </div>
  <% else %>
    <p class="glass p-8 text-center text-slate-500"><%= t(".empty_upcoming") %></p>
  <% end %>
</section>

<section>
  <h2 class="mb-4 flex items-center gap-2.5 text-sm font-semibold uppercase tracking-wider text-slate-400">
    <%= icon :clock, css_class: "h-4 w-4 text-slate-500" %>
    <%= t(".past") %>
  </h2>
  <% if @past.any? %>
    <div class="glass overflow-x-auto p-0">
      <%= render "table", reservations: @past, cancellable: false %>
    </div>
  <% else %>
    <p class="glass p-8 text-center text-slate-500"><%= t(".empty_past") %></p>
  <% end %>
</section>
