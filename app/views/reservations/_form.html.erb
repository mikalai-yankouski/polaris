<%= form_with model: [zone, reservation], url: zone_reservations_path(zone),
      class: "mt-6 space-y-5",
      data: {
        controller: "booking",
        booking_rules_value: zone.price_rules.map { |r| { day_kind: r.day_kind, start_minutes: r.start_minutes, end_minutes: r.end_minutes, rate: r.hourly_rate_cents } }.to_json,
        booking_base_rate_value: zone.hourly_rate_cents,
        booking_currency_value: "BYN"
      } do |form| %>
  <% if reservation.errors.any? %>
    <div class="flash flash--alert">
      <ul class="list-inside list-disc">
        <% reservation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Дата — календарь всегда открыт: клик по дате выбирает её без лишнего шага ---------- %>
  <div data-controller="calendar">
    <%= form.hidden_field :booking_date,
          data: { calendar_target: "input", booking_target: "date", action: "change->booking#recalculate" } %>
    <span class="label"><%= Reservation.human_attribute_name(:booking_date) %></span>
    <div class="cal">
      <div class="cal-head">
        <button type="button" class="cal-nav" data-calendar-target="prev" data-direction="-1"
                data-action="calendar#nav" aria-label="Предыдущий месяц">
          <%= icon :chevron_left, css_class: "h-4 w-4" %>
        </button>
        <span class="cal-title" data-calendar-target="title"></span>
        <button type="button" class="cal-nav" data-direction="1"
                data-action="calendar#nav" aria-label="Следующий месяц">
          <%= icon :chevron_right, css_class: "h-4 w-4" %>
        </button>
      </div>
      <div data-calendar-target="grid"></div>
    </div>
  </div>

  <%# Время не обязательно: занятость видит только персонал, окно согласуем по телефону ---------- %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="sel" data-controller="custom-select">
      <span class="label"><%= Reservation.human_attribute_name(:start_time) %></span>
      <input type="hidden" name="reservation[start_time]" value="<%= reservation.start_time %>"
             data-custom-select-target="input" data-booking-target="startTime"
             data-action="change->booking#recalculate">
      <button type="button" class="sel-btn" data-custom-select-target="button" data-action="custom-select#toggle">
        <span data-custom-select-target="label"><%= reservation.start_time.presence || t(".time_optional") %></span>
        <%= icon :chevron_down, css_class: "h-4 w-4 shrink-0 text-slate-500" %>
      </button>
      <div class="sel-panel hidden" data-custom-select-target="panel">
        <button type="button" class="sel-opt" data-value="" data-label="<%= t(".time_optional") %>"
                data-action="custom-select#pick">
          <span><%= t(".time_optional") %><span class="sel-hint"><%= t(".start_time_hint") %></span></span>
        </button>
        <% booking_time_options.each do |time| %>
          <button type="button" class="sel-opt num" data-value="<%= time %>" data-label="<%= time %>"
                  data-action="custom-select#pick"><%= time %></button>
        <% end %>
      </div>
    </div>
    <div class="sel" data-controller="custom-select">
      <% default_duration = reservation.booking_duration.presence&.to_i || booking_duration_default(zone) %>
      <span class="label"><%= Reservation.human_attribute_name(:duration_minutes) %></span>
      <input type="hidden" name="reservation[booking_duration]" value="<%= default_duration %>"
             data-custom-select-target="input" data-booking-target="duration"
             data-action="change->booking#recalculate">
      <button type="button" class="sel-btn" data-custom-select-target="button" data-action="custom-select#toggle">
        <span data-custom-select-target="label"><%= duration_text(default_duration) %></span>
        <%= icon :chevron_down, css_class: "h-4 w-4 shrink-0 text-slate-500" %>
      </button>
      <div class="sel-panel hidden" data-custom-select-target="panel">
        <% booking_duration_options(zone).each do |label, minutes| %>
          <button type="button" class="sel-opt num" data-value="<%= minutes %>" data-label="<%= label %>"
                  data-action="custom-select#pick"><%= label %></button>
        <% end %>
      </div>
    </div>
  </div>

  <%# Гость: идентификация по имени и телефону (аккаунт не нужен) ---------- %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :guest_name, class: "label" %>
      <%= form.text_field :guest_name, required: !authenticated?, autofocus: false,
            placeholder: t(".guest_name_placeholder"), class: "field" %>
    </div>
    <div>
      <%= form.label :guest_phone, class: "label" do %>
        <%= Reservation.human_attribute_name(:guest_phone) %><span class="label-star" title="Обязательное поле">*</span>
      <% end %>
      <%= form.telephone_field :guest_phone, required: !authenticated?,
            placeholder: "+375 (29) 000-00-00", class: "field" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :guests_count, class: "label" %>
      <%= form.number_field :guests_count, min: 1, max: zone.capacity, required: true, class: "field" %>
    </div>
    <div>
      <%= form.label :purpose, class: "label" %>
      <%= form.text_field :purpose, class: "field" %>
    </div>
  </div>

  <%# Живой расчёт: длительность и стоимость по тарифной сетке ---------- %>
  <div data-booking-target="summary" class="calc-box hidden px-5 py-4">
    <div class="calc-label flex items-center gap-2.5 text-sm">
      <%= icon :clock, css_class: "calc-icon h-4 w-4" %>
      <span data-booking-target="durationLabel" class="calc-strong"></span>
    </div>
    <div class="text-right">
      <span class="calc-caption block text-[0.65rem] font-semibold uppercase tracking-widest"><%= t(".calc_total") %></span>
      <span data-booking-target="total" class="calc-total heading-display text-lg font-semibold"></span>
    </div>
  </div>

  <label class="choice-row">
    <%= form.check_box :children_party, class: "mt-0.5" %>
    <span>
      <span class="font-medium"><%= Reservation.human_attribute_name(:children_party) %></span>
      <span class="calc-caption mt-0.5 block text-xs"><%= t("reservations.form.children_party_hint") %></span>
    </span>
  </label>

  <%= form.submit t(".submit"), class: "#{night_design? ? "btn btn--aurora" : "btn-ink"} w-full sm:w-auto" %>
<% end %>
