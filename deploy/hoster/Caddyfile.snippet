# Polaris — временно по IP, домена пока нет. Когда появится домен:
# заменить заголовок на `polaris.example.by { ... }` — Caddy сам выпустит TLS.
http://87.232.65.174 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-if-cross-origin
	}
	reverse_proxy polaris-app:80
}
